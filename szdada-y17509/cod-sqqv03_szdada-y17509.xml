        <head xml:id="szdada-y17509-Hd1e101">Praeambulum</head>
        <p xml:id="szdada-y17509-d1e103">
          <pb ed="#P" n="713"/>
          <cb ed="#P" n="a"/>
          <lb ed="#P" n="1"/>LIBER QUARTUS.
          <lb ed="#P" n="2"/>POTENTIA INTELLECTIVA
        </p>
        <p xml:id="szdada-y17509-d1e114">
          <lb ed="#P" n="3"/>De materia hujus libri multa habentur, lib. 2,
          <lb ed="#P" n="4"/>de Angelis fere per totum. — Disputavit 
          Aristo<lb break="no" ed="#P" n="5"/>teles de hac materia 3, de Anima, a cap. 4,
          <lb ed="#P" n="6"/>secundum divisionem Graecorum, juxta 
          divi<lb break="no" ed="#P" n="7"/>sionem autem Commentatoris a textu primo:
          <lb ed="#P" n="8"/>etsi vero pleraque de intellectu pronuntiet,
          <lb ed="#P" n="9"/>multo vero plura theologi ac philosophi 
          Chris<lb break="no" ed="#P" n="10"/>tiani, nominatim D. Thomas, 1 part., quaest.
          <lb ed="#P" n="11"/>T9 et 84, et sequentibus tradere solent.
        </p>
      </div>
