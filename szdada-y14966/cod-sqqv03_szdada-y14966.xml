      <div xml:id="szdada-y14966"><!-- t3l3prae -->
        <head xml:id="szdada-y14966-Hd1e101">Praeambulum</head>
        <p xml:id="szdada-y14966-d1e103">
          <pb ed="#P" n="613"/>
          <cb ed="#P" n="a"/>
          <lb ed="#P" n="1"/>LIBER TERTIUS
          <lb ed="#P" n="2"/>DE
          <lb ed="#P" n="3"/>POTENTIIS COGNOSCITIVIS
          <lb ed="#P" n="4"/>IN COMMUNI, AC ETIAM SENSITIVIS.
        </p>
        <p xml:id="szdada-y14966-d1e119">
          <cb ed="#P" n="b"/>
          <lb ed="#P" n="5"/>Diximus de potentiis animae vegetativae, 
          su<lb break="no" ed="#P" n="6"/>perest hoc in libro dicendum de sensitivis,
          <lb ed="#P" n="7"/>quia tamen cum intellectiva in sequenti libro
          <lb ed="#P" n="8"/>exp'icanda conveniunt in ratione cognoscendi,
          <lb ed="#P" n="9"/>operae pretium erit rationem hanc utrisque
          <lb ed="#P" n="10"/>generalem per septem sequentia capita prius
          <lb ed="#P" n="11"/>enodare: sic namque et repetitionem 
          multa<lb break="no" ed="#P" n="12"/>rum quaestionum fugiemus, et praeterea, (quod
          <lb ed="#P" n="13"/>praecipue intendimus) intelligimus ordinem
          <lb ed="#P" n="14"/>et connexionem, quam hae potentiae habent
          <lb ed="#P" n="15"/>in homine, in quo reperiuntur omnes 
          tan<lb break="no" ed="#P" n="16"/>quam in uno principio radicatae.
        </p>
      </div>
    </body>
