      <div xml:id="szdada-y18518"><!-- t3l5prae -->
        <head xml:id="szdada-y18518-Hd1e101">Praeambulum</head>
        <p xml:id="szdada-y18518-d1e103">
          <cb ed="#P" n="c"/>
          <lb ed="#P" n="26"/>LIBER QUINTUS
          <lb ed="#P" n="27"/>DE POTENTIA APPETENDI
          <lb ed="#P" n="28"/>TAM IN COMMUNI, QUAM IN SPECIALI, AC LOCO MOVENDI.
        </p>
        <p xml:id="szdada-y18518-d1e114">
          <cb ed="#P" n="d"/>
          <lb ed="#P" n="29"/>Quinque distinxit Aristoteles, in principio
          <lb ed="#P" n="30"/>secundi libri, de Anima potentiarum animae
          <lb ed="#P" n="31"/>genera, ex quibus tria sunt a nobis explicata,
          <lb ed="#P" n="32"/>scilicet potentiae, vegetativae, sensitivae et 
          in<lb break="no" ed="#P" n="33"/>tellectivae: superest, ut de potentiis appetitivis
          <lb ed="#P" n="34"/>dicamus, atque adeo de potentia motiva 
          se<lb break="no" ed="#P" n="35"/>cundum locum, quae cum appetitivis magnam
          <lb ed="#P" n="36"/>affinitatem habet, de quibus idem Aristoteles
          <lb ed="#P" n="37"/>indistincte egit in reliqua parte tertiide Anima,
          <lb ed="#P" n="38"/>methodice vero D. Thomas, 1 part., aquaest. 80
          <lb ed="#P" n="39"/>et ultra, aliique Scholastici Christiani.
        </p>
      </div>
